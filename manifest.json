{
  "manifest_version": 3,
  "name": "stryke.lol — instagram unfollowers",
  "version": "1.4",
  "description": "Find out who doesn't follow you back on Instagram",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://www.instagram.com/*"]
}
